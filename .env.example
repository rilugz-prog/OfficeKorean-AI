# ---------------------------------------------------------------------------
# Anthropic (Claude) — required for the AI features
# ---------------------------------------------------------------------------
# Get one at https://console.anthropic.com/
# NOTE: For Base44 deployment, set this in Base44 secrets instead: npx base44 secrets set ANTHROPIC_API_KEY=...
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Optional: override the default model (defaults to claude-opus-4-8)
# ANTHROPIC_MODEL=claude-opus-4-8

# ---------------------------------------------------------------------------
# Supabase — required for Phase 2 (accounts, history, phrases, usage limits)
# ---------------------------------------------------------------------------
# Project URL and anon key from Supabase → Project Settings → API.
# If these are omitted the app still runs as the anonymous Phase 1 MVP
# (translation / cultural filter / explain Korean), just without accounts.
# NEXT_PUBLIC_SUPABASE_URL=your-supabase-url-here
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: used by the Supabase CLI for migrations (never expose to the client).
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
