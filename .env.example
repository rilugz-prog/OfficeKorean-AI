# ---------------------------------------------------------------------------
# Anthropic (Claude) — required for the AI features
# ---------------------------------------------------------------------------
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Optional: override the default model (defaults to claude-opus-4-8)
# ANTHROPIC_MODEL=claude-opus-4-8

# ---------------------------------------------------------------------------
# Neon PostgreSQL — required for Phase 2 (accounts, history, phrases, usage)
# ---------------------------------------------------------------------------
# Pooled connection string from the Neon dashboard → Connection Details →
# "Pooled connection". Used by Drizzle ORM + @neondatabase/serverless.
# If omitted the app still runs the anonymous MVP (translation / cultural
# filter / explain Korean), just without accounts.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# ---------------------------------------------------------------------------
# Clerk Authentication — required for Phase 2 accounts
# ---------------------------------------------------------------------------
# From the Clerk dashboard → API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-key-here
CLERK_SECRET_KEY=sk_test_your-key-here

# Webhook signing secret from Clerk dashboard → Webhooks → your endpoint.
# Verifies /api/webhooks/clerk requests (svix). Endpoint URL should be
# https://<your-domain>/api/webhooks/clerk subscribed to user.* events.
CLERK_WEBHOOK_SECRET=whsec_your-secret-here

# Clerk routing — these match the app's custom auth pages.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
